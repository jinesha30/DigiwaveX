# DigiWave X — Environment Variables Configuration

# Google Gemini API Key (you can use either GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Optional Gemini model selection (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
